<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cadetBlue">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Tytuł okna z imieniem i nazwiskiem wykonawcy -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:text="@string/tytul"
            android:textColor="#000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/numer" />

        <EditText
            android:id="@+id/etNumer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/azure"
            android:inputType="number"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/imie" />

        <EditText
            android:id="@+id/etImie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/azure"
            android:inputType="textPersonName"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/nazwisko" />

        <EditText
            android:id="@+id/etNazwisko"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/azure"
            android:inputType="textPersonName"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/kolor_oczu" />

        <!-- Można wybrać tylko jedną opcję, domyślnie "niebieskie" -->
        <RadioGroup
            android:id="@+id/rgKolorOczu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checkedButton="@+id/rbNiebieskie">

            <RadioButton
                android:id="@+id/rbNiebieskie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/niebieskie" />

            <RadioButton
                android:id="@+id/rbZielone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/zielone" />

            <RadioButton
                android:id="@+id/rbPiwne"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/piwne" />
        </RadioGroup>

        <!-- Zdjęcie i odcisk palca: obie z wysokością 180dp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivZdjecie"
                android:layout_width="wrap_content"
                android:layout_height="180dp"
                android:layout_marginEnd="16dp"
                android:adjustViewBounds="true" />

            <ImageView
                android:id="@+id/ivOdcisk"
                android:layout_width="wrap_content"
                android:layout_height="180dp"
                android:adjustViewBounds="true" />
        </LinearLayout>

        <Button
            android:id="@+id/btnOk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/azure"
            android:text="@string/ok"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#000000"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
